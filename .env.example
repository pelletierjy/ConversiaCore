# Google Gemini API key (used for content generation and embeddings)
GEMINI_API_KEY=

# Groq API key (fallback chat provider; free tier — see https://console.groq.com)
GROQ_API_KEY=

# OpenRouter API key (another fallback chat provider; free tier — see https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# DeepSeek API key (additional free fallback with ~10 req/min and ~10M tokens/day — see https://api.deepseek.com)
DEEPSEEK_API_KEY=

# Hugging Face API key (additional free fallback with $0.10/mo credit — see https://huggingface.co/settings/tokens)
HUGGING_FACE_API_KEY=

# Firebase Web SDK configuration (Firestore project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Admin CLI (tools/conversia-admin) — feature 002-secure-embed-telemetry ---
# Deployed worker URL (the CLI calls <url>/admin/* on it)
CONVERSIA_WORKER_URL=
# Same value as the ADMIN_TOKEN worker secret (wrangler secret put ADMIN_TOKEN)
CONVERSIA_ADMIN_TOKEN=

# --- Standalone SPA credential (feature 002-secure-embed-telemetry) ---
# Only for the operator-hosted SPA (GitHub Pages). The build inlines these into the bundle
# so the page can inject window.conversiaClient for itself — embedding hosts NEVER use these
# (they inject their own per contracts/embedder-injection.md; widget bundles stay credential-free).
# In CI the values come from the VITE_CONVERSIA_REMOTE_ID / VITE_CONVERSIA_CLIENT_KEY repo secrets.
VITE_CONVERSIA_REMOTE_ID=
VITE_CONVERSIA_CLIENT_KEY=
