# Google Gemini API key (used for content generation and embeddings)
GEMINI_API_KEY=

# Groq API key (fallback chat provider; free tier — see https://console.groq.com)
GROQ_API_KEY=

# OpenRouter API key (another fallback chat provider; free tier — see https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Firebase Web SDK configuration (Firestore project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
