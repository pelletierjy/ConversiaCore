rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /knowledgeEntries/{doc} {
      allow read, write: if true;
    }
    match /embeddingVectors/{doc} {
      allow read, write: if true;
    }
    match /appConfig/{doc} {
      allow read, write: if true;
    }
  }
}
